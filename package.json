{
  "name": "@chantouchsek/validatorjs",
  "type": "module",
  "version": "2.3.0",
  "packageManager": "pnpm@10.26.0",
  "description": "The validator.js library makes data validation in JavaScript very easy in both the browser and Node.js.",
  "author": {
    "name": "Chantouch Sek",
    "email": "chantouchsek.cs83@gmail.com",
    "url": "https://chantouchsek.me"
  },
  "license": "MIT",
  "homepage": "https://github.com/chantouchsek/validatorjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chantouchsek/validatorjs.git"
  },
  "bugs": {
    "url": "https://github.com/chantouchsek/validatorjs/issues"
  },
  "keywords": [
    "validator",
    "validatorjs",
    "node-validator"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/main.mjs",
      "require": "./dist/main.cjs"
    },
    "./phone": {
      "import": "./dist/phone.mjs",
      "require": "./dist/phone.cjs"
    }
  },
  "main": "./dist/main.cjs",
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.ts",
  "typesVersions": {
    "*": {
      "phone": [
        "./dist/phone.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^12.20.0 || >=14.13.0"
  },
  "scripts": {
    "build": "unbuild",
    "test": "vitest --run",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage",
    "test:package": "node scripts/check-package.ts",
    "release": "changelogen --release && git push --follow-tags origin main && pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "libphonenumber-js": "^1.13.15"
  },
  "peerDependenciesMeta": {
    "libphonenumber-js": {
      "optional": true
    }
  },
  "dependencies": {
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "libphonenumber-js": "^1.13.15",
    "lint-staged": "^17.6.0",
    "node-notifier": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint . --fix"
  },
  "engineStrict": true
}
