{
  "name": "@chantouchsek/validatorjs",
  "type": "module",
  "version": "2.2.8",
  "packageManager": "pnpm@10.26.0",
  "description": "The validator.js library makes data validation in JavaScript very easy in both the browser and Node.js.",
  "author": {
    "name": "Chantouch Sek",
    "email": "chantouchsek.cs83@gmail.com",
    "url": "https://chantouchsek.me"
  },
  "license": "MIT",
  "homepage": "https://github.com/chantouchsek/validatorjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chantouchsek/validatorjs.git"
  },
  "bugs": {
    "url": "https://github.com/chantouchsek/validatorjs/issues"
  },
  "keywords": [
    "validator",
    "validatorjs",
    "node-validator"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/main.mjs",
      "require": "./dist/main.cjs"
    }
  },
  "main": "./dist/main.cjs",
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^12.20.0 || >=14.13.0"
  },
  "scripts": {
    "build": "unbuild",
    "test": "vitest --run",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage",
    "test:package": "node scripts/check-package.ts",
    "release": "changelogen --release && git push --follow-tags origin main && pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lodash-es": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "changelogen": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "node-notifier": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint . --fix"
  },
  "engineStrict": true
}
